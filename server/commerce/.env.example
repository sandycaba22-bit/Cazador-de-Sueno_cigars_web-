# ---------------------------------------------------------------------------
# Servicio de comercio (cds-commerce)
#
# En producción este fichero vive en /etc/cazador-de-suenos/commerce.env con
# permisos 0640 y propietario root:www-data. Nunca dentro del repositorio.
# ---------------------------------------------------------------------------

NODE_ENV=production
COMMERCE_PORT=8788
COMMERCE_HOST=127.0.0.1

# Dominio canónico. Cualquier otro origen recibe 403.
COMMERCE_CORS_ORIGINS=https://www.cazadordesuenocigars.com

# Directorio de pedidos. DEBE estar fuera de /var/www.
COMMERCE_DATA_DIR=/var/lib/cazador-de-suenos/commerce

# Clave para firmar las cotizaciones. Genérala con:
#   openssl rand -hex 32
# Si cambia, las cotizaciones en curso caducan (el cliente solo recarga).
COMMERCE_QUOTE_SECRET=
COMMERCE_QUOTE_TTL_SECONDS=900

# Ventana en la que un reintento con la misma Idempotency-Key devuelve el
# resultado anterior en lugar de volver a cobrar.
COMMERCE_IDEMPOTENCY_TTL_SECONDS=3600

# Límites por IP y minuto.
COMMERCE_RATE_WINDOW_MS=60000
COMMERCE_RATE_MAX_QUOTES=60
COMMERCE_RATE_MAX_PAYMENTS=8

# Modo de prueba. Retirado del checkout: debe quedar siempre en false.
COMMERCE_SANDBOX_ENABLED=false

# ---------------------------------------------------------------------------
# CardNET — pídele estos datos a tu ejecutivo de cuenta
# ---------------------------------------------------------------------------
# Mientras CARDNET_ENABLED sea false, el checkout solo ofrece transferencia / PayPal.
CARDNET_ENABLED=false

# Certificación: https://labservicios.cardnet.com.do/servicios/tokens
# Producción:    https://servicios.cardnet.com.do/servicios/tokens
CARDNET_BASE_URL=https://labservicios.cardnet.com.do/servicios/tokens

# La pública viaja al navegador (es su función). La privada jamás sale de aquí.
CARDNET_PUBLIC_ACCOUNT_KEY=
CARDNET_PRIVATE_ACCOUNT_KEY=

# Moneda con la que el afiliado está habilitado a liquidar.
CARDNET_CURRENCY=DOP

# El catálogo está en USD. Si liquidas en DOP hay que fijar la tasa; sin ella
# el servicio se niega a cobrar con tarjeta en lugar de adivinar un importe.
CARDNET_USD_DOP_RATE=

CARDNET_TIMEOUT_MS=30000
CARDNET_CAPTURE=true

BANK_TRANSFER_ENABLED=true

# ---------------------------------------------------------------------------
# PayPal Checkout — Client ID público + secret de servidor (producción)
# ---------------------------------------------------------------------------
# Con Client ID + Secret el servicio activa PayPal automáticamente.
# En producción el modo por defecto es live (USD reales).
#   1. App Live en https://developer.paypal.com/dashboard/applications
#   2. Copia Client ID y Secret de Live
#   3. PAYPAL_MODE=live (obligatorio en producción)
PAYPAL_ENABLED=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
PAYPAL_CURRENCY=USD
PAYPAL_TIMEOUT_MS=30000

# Contacto para derivar incidencias de pago.
HOUSE_WHATSAPP_E164=18094645016
HOUSE_EMAIL=cazadordesueno2024@gmail.com
