# Local: copia a server/b2b-outreach/.env (no se sube a git).
# Servidor: NUNCA hagas cp de este archivo sobre /etc/cazador-de-suenos/b2b-outreach.env
# si ya existe. Usa: sudo bash /var/www/html/deploy/install-cds-b2b-outreach.sh
# o deploy/sync-b2b-outreach-env.ps1 desde Windows.

# BotFather entrega el token. El chat id es el tuyo, no el del prospecto.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firma en borradores. El correo sale de aquí; no lo escribas en el código.
# El typo cazardordesuenol@gmail.com se ignora.
FIRMA_EMAIL=cazadordesueno1@gmail.com
FIRMA_TELEFONO=+1 (809) 464-5016

# Cola 24/7. En producción systemd usa /var/lib/... (logs y registro_leads van ahí).
# B2B_QUEUE_DIR=/var/lib/cazador-de-suenos/b2b-outreach
# B2B_POLL_SECONDS=15
# B2B_LOG_DIR=/var/lib/cazador-de-suenos/b2b-outreach/logs
# B2B_DATA_DIR=/var/lib/cazador-de-suenos/b2b-outreach/data

# Fuente de prospectos:
#   google → solo Google Places (decisión vigente)
#   ambas  → Google primero + OpenStreetMap de respaldo
#   osm    → solo OpenStreetMap
#   auto   → ambas si hay GOOGLE_PLACES_API_KEY, si no osm
FUENTE_LEADS=google
B2B_ZONA_BUSQUEDA=caribe
# Rotación por zonas; foco actual: 50 estados + DC, Puerto Rico y Jamaica
# B2B_MAX_PAISES_POR_BUSCAR=18
# B2B_RD_CIUDADES_MAX=8
OSM_USER_AGENT=CazadorDeSuenosB2B/1.0 (contact: cazadordesueno1@gmail.com)
# OSM_OVERPASS_TIMEOUT=45
# OSM_OVERPASS_PAUSE_SEC=2
# OSM_SEGUNDA_PASADA=0

# Google Places (New) — Text Search, una llamada por búsqueda, sin Place Details.
# Servidor: en /var/www/html/server/b2b-outreach/.env o en /etc/cazador-de-suenos/b2b-outreach.env
# (si en /etc está vacía, se usa la del .env). Nunca en git ni en logs.
# Supabase. La publishable key también está en js/supabase-public.js.
# SUPABASE_SERVICE_ROLE_KEY se rellena solo en el servidor y no se sube.
SUPABASE_URL=https://moptcgtbvsjzzuqbjfzo.supabase.co
SUPABASE_ANON_KEY=sb_publishable_y2qece4Z92W2BMjxp5jigg_E3L8RHuF
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=

GOOGLE_PLACES_API_KEY=
# Topes con contador persistente en data/places_budget.json. Dos tandas al día (09:00 y 15:00,
# B2B_TZ=America/Santo_Domingo) de hasta 15 búsquedas. Al llegar a un tope o ante un error
# 4xx/5xx: para Google, avisa por Telegram y sigue con OSM.
GOOGLE_PLACES_MAX_CALLS_PER_RUN=15
GOOGLE_PLACES_MAX_CALLS_PER_DAY=30
GOOGLE_PLACES_MAX_CALLS_PER_MONTH=900
# Negocios seguros: OPERATIONAL + teléfono + web + rating y reseñas mínimas.
GOOGLE_PLACES_MIN_RATING=4.0
GOOGLE_PLACES_MIN_RESENAS=5
MIN_LEAD_SCORE=4

# Envío al cliente: solo tras aprobación manual. No hay envío automático.
# B2B_ENVIOS_MAX_DIA=15
# B2B_PAUSA_ENTRE_ENVIOS_SEC=120

# --- Envío de correo (clave de aplicación de Google, nunca la contraseña normal) ---
# Pon B2B_ENVIO_REAL=1 en el servidor cuando las claves ya estén. Con 0 no sale ningún correo.
B2B_ENVIO_REAL=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Nombres aceptados: CORREO_REMITENTE_n / CORREO_CLAVE_n  o  EMAIL_REMITENTE_n / EMAIL_CLAVE_n
EMAIL_REMITENTE_1=cazadordesueno1@gmail.com
EMAIL_CLAVE_1=
EMAIL_REMITENTE_2=cazadordesueno2024@gmail.com
EMAIL_CLAVE_2=
CORREO_REMITENTE_1=cazadordesueno1@gmail.com
CORREO_CLAVE_1=
CORREO_REMITENTE_2=cazadordesueno2024@gmail.com
CORREO_CLAVE_2=
# Techo diario (además de la rampa). 30 en total, repartidos entre las dos cuentas.
CORREOS_MAX_DIA=30
# Pausa aleatoria entre envíos automáticos, en segundos.
CORREOS_PAUSA_MIN_SEG=60
CORREOS_PAUSA_MAX_SEG=120
IMAP_HOST=imap.gmail.com
EMPRESA_NOMBRE_LEGAL=Cazador de Sueño Cigars SRL
EMPRESA_DIRECCION_POSTAL=Calle La Barranquita, Sector Las Minas, Calle 3, Edificio 3, Santiago, República Dominicana
EMPRESA_DIRECCION_POSTAL_EN=Calle La Barranquita, Sector Las Minas, Calle 3, Edificio 3, Santiago, Dominican Republic
B2B_ENVIO_RAMPA=30,30,30
B2B_ENVIO_FECHA_INICIO=2026-11-02
B2B_ENVIO_HORA_INICIO=9
B2B_ENVIO_HORA_FIN=17
# Si defines CORREOS_PAUSA_MIN_SEG, estas dos no se usan.
# B2B_ENVIO_PAUSA_MIN=2
# B2B_ENVIO_PAUSA_MAX=5
B2B_ENVIO_MAX_POR_CUENTA=15
B2B_LEADS_POR_TANDA=15
B2B_SEGUIMIENTO_DIAS=4,10
# Recordatorio en Telegram a los 5 días de tocar Enviado.
B2B_SEGUIMIENTO_DIAS_RECORDATORIO=5
# --- Ritmo de tarjetas en Telegram: 15 por la mañana y 15 por la tarde, de una en una ---
B2B_TARJETAS_ABIERTAS_MAX=1
B2B_TARJETAS_POR_TANDA=15
B2B_TARJETAS_POR_DIA=30
B2B_TELEGRAM_POLL_SECONDS=3
