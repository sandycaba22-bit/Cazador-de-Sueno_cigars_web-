# Local: copia a server/b2b-outreach/.env (no se sube a git).
# Servidor: NUNCA hagas cp de este archivo sobre /etc/cazador-de-suenos/b2b-outreach.env
# si ya existe. Usa: sudo bash /var/www/html/deploy/install-cds-b2b-outreach.sh
# o deploy/sync-b2b-outreach-env.ps1 desde Windows.

# BotFather entrega el token. El chat id es el tuyo, no el del prospecto.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firma en borradores (vicepresidenta; líneas opcionales si están vacías).
FIRMA_EMAIL=cazadordesueno1@gmail.com
FIRMA_TELEFONO=

# Cola 24/7. En producción systemd usa /var/lib/... (logs y registro_leads van ahí).
# B2B_QUEUE_DIR=/var/lib/cazador-de-suenos/b2b-outreach
# B2B_POLL_SECONDS=15
# B2B_LOG_DIR=/var/lib/cazador-de-suenos/b2b-outreach/logs
# B2B_DATA_DIR=/var/lib/cazador-de-suenos/b2b-outreach/data

# Fuente de prospectos:
#   google → solo Google Places; nunca OpenStreetMap (recomendado)
#   ambas  → Google Places primero + OpenStreetMap de respaldo
#   osm    → solo OpenStreetMap
#   auto   → google si hay clave; sin clave no cae a OSM
# Sin clave, google para y avisa. No se busca en mercados con activo=false.
FUENTE_LEADS=google
B2B_ZONA_BUSQUEDA=usa
# Rotación: 50 estados + DC (Florida primero). Puerto Rico y Jamaica al final.
# B2B_MAX_PAISES_POR_BUSCAR=18
# B2B_RD_CIUDADES_MAX=8
OSM_USER_AGENT=CazadorDeSuenosB2B/1.0 (contact: cazadordesueno1@gmail.com)
# OSM_OVERPASS_TIMEOUT=45
# OSM_OVERPASS_PAUSE_SEC=2
# OSM_SEGUNDA_PASADA=0

# Google Places (New) — Text Search, una llamada por búsqueda, sin Place Details.
# Servidor: en /var/www/html/server/b2b-outreach/.env o en /etc/cazador-de-suenos/b2b-outreach.env
# (si en /etc está vacía, se usa la del .env). Nunca en git ni en logs.
GOOGLE_PLACES_API_KEY=
# Solo prueba local de la llave (el bot no redacta con Claude en producción).
# ANTHROPIC_API_KEY=
# Topes con contador persistente en data/places_budget.json. Dos tandas al día (09:00 y 15:00,
# B2B_TZ=America/Santo_Domingo) de hasta 15 búsquedas. Al llegar a un tope o ante un error
# 4xx/5xx: para Google, avisa por Telegram y sigue con OSM.
GOOGLE_PLACES_MAX_CALLS_PER_RUN=15
GOOGLE_PLACES_MAX_CALLS_PER_DAY=30
GOOGLE_PLACES_MAX_CALLS_PER_MONTH=900
# Negocios seguros: OPERATIONAL + teléfono + web + rating y reseñas mínimas.
GOOGLE_PLACES_MIN_RATING=4.0
GOOGLE_PLACES_MIN_RESENAS=5
MIN_LEAD_SCORE=4
