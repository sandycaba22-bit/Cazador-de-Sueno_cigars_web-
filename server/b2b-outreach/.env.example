# Local: copia a server/b2b-outreach/.env (no se sube a git).
# Servidor: NUNCA hagas cp de este archivo sobre /etc/cazador-de-suenos/b2b-outreach.env
# si ya existe. Usa: sudo bash /var/www/html/deploy/install-cds-b2b-outreach.sh
# o deploy/sync-b2b-outreach-env.ps1 desde Windows.

# BotFather entrega el token. El chat id es el tuyo, no el del prospecto.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Firma en borradores (vicepresidenta; líneas opcionales si están vacías).
FIRMA_EMAIL=
FIRMA_TELEFONO=

# Cola 24/7. En producción systemd usa /var/lib/... (logs y registro_leads van ahí).
# B2B_QUEUE_DIR=/var/lib/cazador-de-suenos/b2b-outreach
# B2B_POLL_SECONDS=15
# B2B_LOG_DIR=/var/lib/cazador-de-suenos/b2b-outreach/logs
# B2B_DATA_DIR=/var/lib/cazador-de-suenos/b2b-outreach/data

# Buscador sin pagar: deja GOOGLE vacío → OpenStreetMap (FUENTE_LEADS=auto).
# FUENTE_LEADS=auto|osm|google|simulado
FUENTE_LEADS=auto
B2B_ZONA_BUSQUEDA=caribe
# caribe | africa | global — sin --pais, islas primero (export), no África el mismo día
# B2B_OMITIR_MERCADO_LOCAL=0  → incluye RD completa + islas (default)
# B2B_MAX_PAISES_POR_BUSCAR=18
# B2B_RD_CIUDADES_MAX=8
OSM_USER_AGENT=CazadorDeSuenosB2B/1.0 (contact: ventas@cazadordesuenocigars.com)
# OSM_OVERPASS_TIMEOUT=45
# OSM_OVERPASS_PAUSE_SEC=2
# OSM_SEGUNDA_PASADA=0

# Google Places (opcional, de pago). Solo si el negocio ya justifica la API.
GOOGLE_PLACES_API_KEY=
MAX_PLACES_CALLS_DIA=200
MIN_LEAD_SCORE=4
