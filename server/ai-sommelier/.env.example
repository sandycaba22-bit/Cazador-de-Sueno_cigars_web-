# Copia este archivo a .env (local) o a /etc/cazador-de-suenos/ai-sommelier.env (producción).
# Nunca subas este archivo con la clave real al repositorio.

NODE_ENV=production

# Obligatoria — Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo principal. gemini-2.5-flash es el más ágil para chat.
# Para más profundidad de sommelier: gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-pro,gemini-2.0-flash,gemini-1.5-pro

# Solo localhost: Nginx hace de puerta pública en /api/ai-sommelier
PORT=8787
HOST=127.0.0.1

# Contacto real de la casa (enrutamiento B2B)
HOUSE_WHATSAPP=+1 809-464-5016
HOUSE_WHATSAPP_E164=18094645016
HOUSE_EMAIL=cazadordesueno1@gmail.com

# Log de cada respuesta del Maestro Tabaquero en consola / journalctl
LOG_REPLIES=true
