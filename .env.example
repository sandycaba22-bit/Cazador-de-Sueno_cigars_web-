# Archivo de ejemplo para desarrollo local.
#
# El checkout y los cobros viven en `server/commerce/`.
# Puedes copiar este archivo a:
#   - `./.env`                 si arrancas con `node server/server.js`
#   - `server/commerce/.env`   si arrancas solo `node server/commerce/server.js`
#
# En producción NO se usa este fichero: las claves viven en
# `/etc/cazador-de-suenos/commerce.env`.

NODE_ENV=development
COMMERCE_PORT=8788
COMMERCE_HOST=127.0.0.1
COMMERCE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COMMERCE_DATA_DIR=.commerce-data

# Genera una clave local con:
#   openssl rand -hex 32
COMMERCE_QUOTE_SECRET=
COMMERCE_QUOTE_TTL_SECONDS=900
COMMERCE_IDEMPOTENCY_TTL_SECONDS=3600

# Mantener siempre en false: el sandbox antiguo del checkout está retirado.
COMMERCE_SANDBOX_ENABLED=false

# Transferencia bancaria
BANK_TRANSFER_ENABLED=true

# PayPal Sandbox
# 1. Crea una app Sandbox en https://developer.paypal.com/dashboard/applications
# 2. Copia Client ID y Secret de Sandbox
# 3. Mantén PAYPAL_MODE=sandbox mientras hagas pruebas
PAYPAL_ENABLED=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_TIMEOUT_MS=30000

# CardNET queda desactivada localmente salvo que tengas claves reales.
CARDNET_ENABLED=false
CARDNET_BASE_URL=https://labservicios.cardnet.com.do/servicios/tokens
CARDNET_PUBLIC_ACCOUNT_KEY=
CARDNET_PRIVATE_ACCOUNT_KEY=
CARDNET_CURRENCY=DOP
CARDNET_USD_DOP_RATE=
CARDNET_TIMEOUT_MS=30000
CARDNET_CAPTURE=true

HOUSE_WHATSAPP_E164=18094645016
HOUSE_EMAIL=cazadordesueno2024@gmail.com
